    rdfs:label "BSD 2-Clause License"@en ;
    dcterms:identifier "BSD-2-Clause" .

<http://spdx.org/licenses/BSD-3-Clause>
    a dcterms:LicenseDocument ;
    rdfs:label "BSD 3-Clause License"@en ;
    dcterms:identifier "BSD-3-Clause" .

<http://spdx.org/licenses/PSF-2.0>
    a dcterms:LicenseDocument ;
    rdfs:label "Python Software Foundation License 2.0"@en ;
    dcterms:identifier "PSF-2.0" .

<http://spdx.org/licenses/EPL-1.0>
    a dcterms:LicenseDocument ;
    rdfs:label "Eclipse Public License 1.0"@en ;
    dcterms:identifier "EPL-1.0" .

<http://spdx.org/licenses/Ruby>
    a dcterms:LicenseDocument ;
    rdfs:label "Ruby License"@en ;
    dcterms:identifier "Ruby" .

<http://spdx.org/licenses/BSL-1.0>
    a dcterms:LicenseDocument ;
    rdfs:label "Boost Software License 1.0"@en ;
    dcterms:identifier "BSL-1.0" .

