# languages.ttl -- the core graph of the sparqlite tutorial.
# Generated by tutorial/make_tutorial_data.py; edit the script, not this file.
#
# REAL-WORLD DATA about 94 computer languages, 117 people and 40 organisations.
# Facts follow the infoboxes of the English Wikipedia articles ("First appeared",
# "Designed by", "Developer", "Influenced by", ...), checked in October 2026.
# Where a fact was uncertain it was left out, so a missing value means "not
# recorded here", never "no". Designer lists are partial for committee designs.
#
# ex:influencedBy records influences on a language's ORIGINAL design, so the
# influencing language never appeared later and the graph has no cycles (the
# generator checks both). Wikipedia also lists influences on later versions,
# e.g. C# on Java 5; those are deliberately left out.
#
# Shape of a language (all optional except rdf:type and rdfs:label):
#   ex:Python a ex:ProgrammingLanguage ;      # or ex:QueryLanguage
#       rdfs:label "Python"@en ;              # English name, language-tagged
#       skos:altLabel "..." ;                 # other / former names (plain strings)
#       schema:description "..."@en ;         # some also have a short generic phrase
#                                             # (not a translation) @fr @de @es @ja
#       rdfs:comment "..."@en ;               # a trivia note, for some languages
#       ex:firstAppeared 1991 ;               # xsd:integer year
#       ex:firstReleaseDate "1991-02-20"^^xsd:date ;  # only where well documented
#       ex:version1Date "..."^^xsd:date ;     # release date of version 1.0 (a few)
#       ex:designer person:guido-van-rossum ;
#       ex:developer org:psf ;
#       ex:influencedBy ex:ABC , ex:C , ... ; # the language on the right influenced it
#       ex:paradigm ex:Functional , ... ;     # classes in a rdfs:subClassOf hierarchy
#       ex:typing ex:DynamicTyping ; ex:typeStrength ex:StrongTyping ;
#       ex:typeInference true ;
#       ex:fileExtension ".py" , ".pyi" ;     # source code only; case matters
#       schema:url <https://www.python.org/> ; # homepage, only for some languages
#       dcterms:license <http://spdx.org/licenses/PSF-2.0> .  # reference implementation
#
# Names: languages have rdfs:label "..."@en (so match them with "Python"@en or
# STR()); people and organisations have plain schema:name strings. The only
# language-tagged skos:altLabel is ex:ObjectOriented's "object-orientated
# programming"@en-GB, which LANGMATCHES(LANG(?l), "en") matches and LANG(?l) = "en"
# does not.
#
# Prefixed names: person:guido-van-rossum, org:psf ("ex:person/..." is not a valid
# prefixed name, so declare PREFIX person: <http://example.org/pl/person/>).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/pl/> .
@prefix person: <http://example.org/pl/person/> .
@prefix org: <http://example.org/pl/org/> .

# ==============================================================================
# Vocabulary: classes and properties used below
# ==============================================================================

ex:ComputerLanguage
    a rdfs:Class ;
    rdfs:label "computer language"@en ;
    rdfs:comment "Any formal language for computers: programming and query languages."@en .

ex:ProgrammingLanguage
    a rdfs:Class ;
    rdfs:subClassOf ex:ComputerLanguage ;
    rdfs:label "programming language"@en , "langage de programmation"@fr ,
               "Programmiersprache"@de , "lenguaje de programación"@es , "プログラミング言語"@ja .

ex:QueryLanguage
    a rdfs:Class ;
    rdfs:subClassOf ex:ComputerLanguage ;
    rdfs:label "query language"@en , "langage de requête"@fr , "Abfragesprache"@de ,
               "lenguaje de consulta"@es , "問い合わせ言語"@ja .

ex:Person
    a rdfs:Class ;
    rdfs:subClassOf schema:Person ;
    rdfs:label "person"@en .

ex:Organization
    a rdfs:Class ;
    rdfs:subClassOf schema:Organization ;
    rdfs:label "organisation"@en .

ex:TypeDiscipline
    a rdfs:Class ;
    rdfs:label "type discipline"@en .

ex:firstAppeared
    a rdf:Property ;
    rdfs:label "first appeared"@en ;
    rdfs:comment "Year the language first appeared (xsd:integer)."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range xsd:integer .

ex:firstReleaseDate
    a rdf:Property ;
    rdfs:label "first release date"@en ;
    rdfs:comment "Date of the first public release or announcement."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range xsd:date .

ex:version1Date
    a rdf:Property ;
    rdfs:label "version 1.0 date"@en ;
    rdfs:comment "Release date of version 1.0."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range xsd:date .

ex:designer
    a rdf:Property ;
    rdfs:label "designer"@en ;
    rdfs:comment "A person who designed the language. Lists for committee designs are partial."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range ex:Person .

ex:developer
    a rdf:Property ;
    rdfs:label "developer"@en ;
    rdfs:comment "An organisation that developed or maintains the language."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range ex:Organization .

ex:influencedBy
    a rdf:Property ;
    rdfs:label "influenced by"@en ;
    rdfs:comment "The object language influenced the original design of the subject language, so it appeared in the same year or earlier; there are no cycles. Traverse it backwards with ^ex:influencedBy."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range ex:ComputerLanguage .

ex:paradigm
    a rdf:Property ;
    rdfs:label "paradigm"@en ;
    rdfs:comment "A programming paradigm the language supports (a class below ex:Paradigm)."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range rdfs:Class .

ex:typing
    a rdf:Property ;
    rdfs:label "typing"@en ;
    rdfs:comment "When types are checked: static, dynamic, gradual, or untyped."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range ex:TypeDiscipline .

ex:typeStrength
    a rdf:Property ;
    rdfs:label "type strength"@en ;
    rdfs:comment "Strong or weak typing, where uncontroversial."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range ex:TypeDiscipline .

ex:typeInference
    a rdf:Property ;
    rdfs:label "type inference"@en ;
    rdfs:comment "true if the compiler infers most types."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range xsd:boolean .

ex:fileExtension
    a rdf:Property ;
    rdfs:label "file extension"@en ;
    rdfs:comment "A conventional file name extension for source code in the language, with the dot. Case matters: R uses both \".R\" and \".r\"."@en ;
    rdfs:domain ex:ComputerLanguage ;
    rdfs:range xsd:string .

ex:turingAwardYear
    a rdf:Property ;
    rdfs:label "Turing Award year"@en ;
    rdfs:comment "Year the person received the ACM Turing Award."@en ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:integer .

# ==============================================================================
# Paradigms: a small class hierarchy (query it with rdfs:subClassOf*)
#   Paradigm
#     Imperative -> Procedural, ObjectOriented -> ClassBased, PrototypeBased
#     Declarative -> Functional -> PurelyFunctional; Logic
#     Concurrent, ArrayProgramming, Concatenative
# ==============================================================================

ex:Paradigm
    a rdfs:Class ;
    rdfs:label "programming paradigm"@en ;
    rdfs:comment "Root of the paradigm hierarchy. Languages point at paradigms with ex:paradigm."@en .

ex:Imperative
    a rdfs:Class ;
    rdfs:subClassOf ex:Paradigm ;
    rdfs:label "imperative programming"@en , "programmation impérative"@fr ,
               "imperative Programmierung"@de , "programación imperativa"@es , "命令型プログラミング"@ja ;
    rdfs:comment "Programs are sequences of statements that change state."@en .

ex:Procedural
    a rdfs:Class ;
    rdfs:subClassOf ex:Imperative ;
    rdfs:label "procedural programming"@en , "programmation procédurale"@fr ,
               "prozedurale Programmierung"@de , "programación procedimental"@es ,
               "手続き型プログラミング"@ja ;
    rdfs:comment "Imperative programming organised into procedures."@en .

ex:ObjectOriented
    a rdfs:Class ;
    rdfs:subClassOf ex:Imperative ;
    rdfs:label "object-oriented programming"@en , "programmation orientée objet"@fr ,
               "objektorientierte Programmierung"@de , "programación orientada a objetos"@es ,
               "オブジェクト指向プログラミング"@ja ;
    skos:altLabel "object-orientated programming"@en-GB ;
    rdfs:comment "Programs are built from objects that combine state and behaviour."@en .

ex:ClassBased
    a rdfs:Class ;
    rdfs:subClassOf ex:ObjectOriented ;
    rdfs:label "class-based programming"@en ;
    rdfs:comment "Object orientation where objects are instances of classes."@en .

ex:PrototypeBased
    a rdfs:Class ;
    rdfs:subClassOf ex:ObjectOriented ;
    rdfs:label "prototype-based programming"@en , "prototypenbasierte Programmierung"@de ;
    rdfs:comment "Object orientation without classes: objects inherit from other objects."@en .

ex:Declarative
    a rdfs:Class ;
    rdfs:subClassOf ex:Paradigm ;
    rdfs:label "declarative programming"@en , "programmation déclarative"@fr ,
               "deklarative Programmierung"@de , "programación declarativa"@es , "宣言型プログラミング"@ja ;
    rdfs:comment "Programs describe what to compute rather than how."@en .

ex:Functional
    a rdfs:Class ;
    rdfs:subClassOf ex:Declarative ;
    rdfs:label "functional programming"@en , "programmation fonctionnelle"@fr ,
               "funktionale Programmierung"@de , "programación funcional"@es , "関数型プログラミング"@ja ;
    rdfs:comment "Programs are built by applying and composing functions."@en .

ex:PurelyFunctional
    a rdfs:Class ;
    rdfs:subClassOf ex:Functional ;
    rdfs:label "purely functional programming"@en ;
    rdfs:comment "Functional programming without side effects in ordinary functions."@en .

ex:Logic
    a rdfs:Class ;
    rdfs:subClassOf ex:Declarative ;
    rdfs:label "logic programming"@en , "programmation logique"@fr , "logische Programmierung"@de ,
               "programación lógica"@es , "論理プログラミング"@ja ;
    rdfs:comment "Programs are sets of logical facts and rules."@en .

ex:Concurrent
    a rdfs:Class ;
    rdfs:subClassOf ex:Paradigm ;
    rdfs:label "concurrent programming"@en , "programmation concurrente"@fr ,
               "programación concurrente"@es ;
    rdfs:comment "Language-level support for computations that run at the same time."@en .

ex:ArrayProgramming
    a rdfs:Class ;
    rdfs:subClassOf ex:Paradigm ;
    rdfs:label "array programming"@en ;
    rdfs:comment "Operations apply to whole arrays at once."@en .

ex:Concatenative
    a rdfs:Class ;
    rdfs:subClassOf ex:Paradigm ;
    rdfs:label "concatenative (stack-based) programming"@en ;
    rdfs:comment "Programs are compositions of words that operate on a stack."@en .

# ==============================================================================
# Type disciplines
# ==============================================================================

ex:StaticTyping
    a ex:TypeDiscipline ;
    rdfs:label "static typing"@en ;
    rdfs:comment "Types are checked before the program runs."@en .

ex:DynamicTyping
    a ex:TypeDiscipline ;
    rdfs:label "dynamic typing"@en ;
    rdfs:comment "Types are checked while the program runs."@en .

ex:GradualTyping
    a ex:TypeDiscipline ;
    rdfs:label "gradual typing"@en ;
    rdfs:comment "Type annotations are optional; annotated code is checked statically."@en .

ex:Untyped
    a ex:TypeDiscipline ;
    rdfs:label "untyped"@en ;
    rdfs:comment "The language has a single data type (typically the machine word)."@en .

ex:StrongTyping
    a ex:TypeDiscipline ;
    rdfs:label "strong typing"@en ;
    rdfs:comment "Few implicit conversions between unrelated types."@en .

ex:WeakTyping
    a ex:TypeDiscipline ;
    rdfs:label "weak typing"@en ;
    rdfs:comment "Many implicit conversions between types."@en .

# ==============================================================================
# Licences (SPDX identifiers) of reference implementations
# ==============================================================================

<http://spdx.org/licenses/MIT>
    a dcterms:LicenseDocument ;
    rdfs:label "MIT License"@en ;
    dcterms:identifier "MIT" .

<http://spdx.org/licenses/Apache-2.0>
    a dcterms:LicenseDocument ;
    rdfs:label "Apache License 2.0"@en ;
    dcterms:identifier "Apache-2.0" .

<http://spdx.org/licenses/BSD-2-Clause>
