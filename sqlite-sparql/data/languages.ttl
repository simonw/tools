# ==============================================================================
# Languages, in order of first appearance
# ==============================================================================

# FLOW-MATIC (1955) -- Grace Hopper
ex:FlowMatic
    a ex:ProgrammingLanguage ;
    rdfs:label "FLOW-MATIC"@en ;
    skos:altLabel "B-0" ;
    schema:description "Early English-like data-processing language developed under Grace Hopper for the UNIVAC I."@en ;
    ex:firstAppeared 1955 ;
    ex:designer person:grace-hopper ;
    ex:developer org:remington-rand ;
    ex:paradigm ex:Imperative .

# Fortran (1957) -- John Backus
ex:Fortran
    a ex:ProgrammingLanguage ;
    rdfs:label "Fortran"@en ;
    skos:altLabel "FORTRAN" ;
    schema:description "Compiled imperative language for numeric and scientific computing, developed at IBM."@en ;
    rdfs:comment "The name derives from 'Formula Translation'."@en ;
    ex:firstAppeared 1957 ;
    ex:designer person:john-backus ;
    ex:developer org:ibm ;
    ex:paradigm ex:Procedural , ex:ArrayProgramming ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:StrongTyping ;
    ex:fileExtension ".f" , ".for" , ".f90" ;
    schema:url <https://fortran-lang.org/> .

# ALGOL 58 (1958) -- John Backus, Alan Perlis
ex:ALGOL58
    a ex:ProgrammingLanguage ;
    rdfs:label "ALGOL 58"@en ;
    skos:altLabel "IAL" ;
    schema:description "The first ALGOL, originally called the International Algebraic Language (IAL)."@en ;
    ex:firstAppeared 1958 ;
    ex:designer person:john-backus , person:alan-perlis ;
    ex:paradigm ex:Procedural ;
    ex:influencedBy ex:Fortran .

# COBOL (1960) -- Jean E. Sammet
ex:COBOL
    a ex:ProgrammingLanguage ;
    rdfs:label "COBOL"@en ;
    skos:altLabel "Common Business-Oriented Language" ;
    schema:description "Common Business-Oriented Language, designed for business data processing."@en ;
    rdfs:comment "CODASYL started the design in 1959; the first specification followed in 1960."@en ;
    ex:firstAppeared 1960 ;
    ex:designer person:jean-sammet ;
    ex:developer org:codasyl ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:WeakTyping ;
    ex:fileExtension ".cbl" , ".cob" , ".cpy" ;
    ex:influencedBy ex:FlowMatic .

# Lisp (1960) -- John McCarthy
ex:Lisp
    a ex:ProgrammingLanguage ;
    rdfs:label "Lisp"@en ;
    skos:altLabel "LISP" ;
    schema:description "Family of languages built around list processing, where code is data."@en ;
    rdfs:comment "The name derives from 'LISt Processor'."@en ;
    ex:firstAppeared 1960 ;
    ex:designer person:john-mccarthy ;
    ex:paradigm ex:Functional , ex:Procedural ;
    ex:typing ex:DynamicTyping ;
    ex:typeStrength ex:StrongTyping .

# ALGOL 60 (1960) -- John Backus, Peter Naur, Alan Perlis, John McCarthy, Adriaan van Wijngaarden
ex:ALGOL60
    a ex:ProgrammingLanguage ;
    rdfs:label "ALGOL 60"@en ;
    schema:description "Block-structured algorithmic language whose report popularised Backus-Naur form."@en ;
    ex:firstAppeared 1960 ;
    ex:designer person:john-backus , person:peter-naur , person:alan-perlis ,
                person:john-mccarthy , person:adriaan-van-wijngaarden ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:influencedBy ex:ALGOL58 .

# SNOBOL (1962) -- David J. Farber, Ralph E. Griswold, Ivan P. Polonsky
ex:SNOBOL
    a ex:ProgrammingLanguage ;
    rdfs:label "SNOBOL"@en ;
    schema:description "String-oriented language with built-in pattern matching, developed at Bell Labs."@en ;
    ex:firstAppeared 1962 ;
    ex:designer person:david-farber , person:ralph-griswold , person:ivan-polonsky ;
    ex:developer org:bell-labs ;
    ex:paradigm ex:Imperative .

# Simula (1962) -- Ole-Johan Dahl, Kristen Nygaard
ex:Simula
    a ex:ProgrammingLanguage ;
    rdfs:label "Simula"@en ;
    schema:description "Simulation language that introduced classes, objects and inheritance."@en ,
                       "langage de programmation orienté objet"@fr ,
                       "objektorientierte Programmiersprache"@de ,
                       "lenguaje de programación orientado a objetos"@es , "オブジェクト指向プログラミング言語"@ja ;
    ex:firstAppeared 1962 ;
    ex:designer person:ole-johan-dahl , person:kristen-nygaard ;
    ex:developer org:norwegian-computing-center ;
    ex:paradigm ex:Procedural , ex:ClassBased ;
    ex:typing ex:StaticTyping ;
    ex:influencedBy ex:ALGOL60 .

# CPL (1963) -- Christopher Strachey
ex:CPL
    a ex:ProgrammingLanguage ;
    rdfs:label "CPL"@en ;
    skos:altLabel "Combined Programming Language" ;
    schema:description "Combined Programming Language, developed by the universities of Cambridge and London."@en ;
    ex:firstAppeared 1963 ;
    ex:designer person:christopher-strachey ;
    ex:paradigm ex:Procedural ;
    ex:influencedBy ex:ALGOL60 .

# BASIC (1964) -- John G. Kemeny, Thomas E. Kurtz
ex:BASIC
    a ex:ProgrammingLanguage ;
    rdfs:label "BASIC"@en ;
    skos:altLabel "Beginners' All-purpose Symbolic Instruction Code" ;
    schema:description "Beginners' All-purpose Symbolic Instruction Code, created at Dartmouth College for teaching."@en ;
    ex:firstAppeared 1964 ;
    ex:firstReleaseDate "1964-05-01"^^xsd:date ;
    ex:designer person:john-kemeny , person:thomas-kurtz ;
    ex:developer org:dartmouth-college ;
    ex:paradigm ex:Procedural ;
    ex:influencedBy ex:ALGOL60 , ex:Fortran .

# PL/I (1964)
ex:PLI
    a ex:ProgrammingLanguage ;
    rdfs:label "PL/I"@en ;
    skos:altLabel "PL/1" ;
    schema:description "Programming Language One, IBM's language for both scientific and business work."@en ;
    ex:firstAppeared 1964 ;
    ex:developer org:ibm ;
    ex:paradigm ex:Procedural ;
    ex:influencedBy ex:COBOL , ex:Fortran , ex:ALGOL60 .

# APL (1966) -- Kenneth E. Iverson
ex:APL
    a ex:ProgrammingLanguage ;
    rdfs:label "APL"@en ;
    skos:altLabel "A Programming Language" ;
    schema:description "Array language with a concise notation built from special symbols."@en ;
    rdfs:comment "Named after Kenneth Iverson's 1962 book 'A Programming Language'."@en ;
    ex:firstAppeared 1966 ;
    ex:designer person:kenneth-iverson ;
    ex:developer org:ibm ;
    ex:paradigm ex:ArrayProgramming , ex:Functional ;
    ex:typing ex:DynamicTyping .

# ISWIM (1966) -- Peter Landin
ex:ISWIM
    a ex:ProgrammingLanguage ;
    rdfs:label "ISWIM"@en ;
    skos:altLabel "If you See What I Mean" ;
    schema:description "Peter Landin's abstract language that shaped later functional languages."@en ;
    ex:firstAppeared 1966 ;
    ex:designer person:peter-landin ;
    ex:paradigm ex:Functional ;
    ex:influencedBy ex:ALGOL60 , ex:Lisp .

# ALGOL W (1966) -- Niklaus Wirth, Tony Hoare
ex:ALGOLW
    a ex:ProgrammingLanguage ;
    rdfs:label "ALGOL W"@en ;
    schema:description "Niklaus Wirth and Tony Hoare's proposed successor to ALGOL 60."@en ;
    ex:firstAppeared 1966 ;
    ex:designer person:niklaus-wirth , person:tony-hoare ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:influencedBy ex:ALGOL60 .

# BCPL (1967) -- Martin Richards
ex:BCPL
    a ex:ProgrammingLanguage ;
    rdfs:label "BCPL"@en ;
    skos:altLabel "Basic Combined Programming Language" ;
    schema:description "Basic Combined Programming Language, a typeless language for writing compilers and systems."@en ;
    ex:firstAppeared 1967 ;
    ex:designer person:martin-richards ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:Untyped ;
    ex:influencedBy ex:CPL .

# Logo (1967) -- Wally Feurzeig, Seymour Papert, Cynthia Solomon
ex:Logo
    a ex:ProgrammingLanguage ;
    rdfs:label "Logo"@en ;
    schema:description "Educational language best known for turtle graphics."@en ;
    ex:firstAppeared 1967 ;
    ex:designer person:wally-feurzeig , person:seymour-papert , person:cynthia-solomon ;
    ex:paradigm ex:Functional , ex:Procedural ;
    ex:typing ex:DynamicTyping ;
    ex:influencedBy ex:Lisp .

# ALGOL 68 (1968) -- Adriaan van Wijngaarden
ex:ALGOL68
    a ex:ProgrammingLanguage ;
    rdfs:label "ALGOL 68"@en ;
    schema:description "Successor to ALGOL 60 with an orthogonal design, defined by a two-level grammar."@en ;
    ex:firstAppeared 1968 ;
    ex:designer person:adriaan-van-wijngaarden ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:StrongTyping ;
    ex:influencedBy ex:ALGOL60 .

# B (1969) -- Ken Thompson
ex:B
    a ex:ProgrammingLanguage ;
    rdfs:label "B"@en ;
    schema:description "Typeless language from Bell Labs derived from BCPL; the predecessor of C."@en ;
    ex:firstAppeared 1969 ;
    ex:designer person:ken-thompson ;
    ex:developer org:bell-labs ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:Untyped ;
    ex:influencedBy ex:BCPL , ex:PLI .

# Pascal (1970) -- Niklaus Wirth
ex:Pascal
    a ex:ProgrammingLanguage ;
    rdfs:label "Pascal"@en ;
    schema:description "Small structured language designed by Niklaus Wirth, widely used for teaching."@en ;
    rdfs:comment "Named after the mathematician Blaise Pascal."@en ;
    ex:firstAppeared 1970 ;
    ex:designer person:niklaus-wirth ;
    ex:developer org:eth-zurich ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:StrongTyping ;
    ex:fileExtension ".pas" ;
    ex:influencedBy ex:ALGOLW , ex:Simula .

# Forth (1970) -- Charles H. Moore
ex:Forth
    a ex:ProgrammingLanguage ;
    rdfs:label "Forth"@en ;
    schema:description "Stack-based, concatenative language with an interactive interpreter."@en ;
    ex:firstAppeared 1970 ;
    ex:designer person:charles-moore ;
    ex:paradigm ex:Concatenative , ex:Procedural ;
    ex:typing ex:Untyped ;
    ex:fileExtension ".fs" , ".fth" , ".4th" .

# C (1972) -- Dennis Ritchie
ex:C
    a ex:ProgrammingLanguage ;
    rdfs:label "C"@en ;
    schema:description "Systems programming language developed at Bell Labs alongside Unix."@en ,
                       "langage de programmation système"@fr , "Systemprogrammiersprache"@de ,
                       "lenguaje de programación de sistemas"@es , "システムプログラミング言語"@ja ;
    ex:firstAppeared 1972 ;
    ex:designer person:dennis-ritchie ;
    ex:developer org:bell-labs ;
    ex:paradigm ex:Procedural ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:WeakTyping ;
    ex:fileExtension ".c" , ".h" ;
    ex:influencedBy ex:B , ex:BCPL , ex:CPL , ex:ALGOL68 , ex:PLI , ex:Fortran .

# Smalltalk (1972) -- Alan Kay, Dan Ingalls, Adele Goldberg
ex:Smalltalk
    a ex:ProgrammingLanguage ;
    rdfs:label "Smalltalk"@en ;
    schema:description "Purely object-oriented language and live programming environment from Xerox PARC."@en ,
                       "langage de programmation orienté objet"@fr ,
                       "objektorientierte Programmiersprache"@de ,
                       "lenguaje de programación orientado a objetos"@es , "オブジェクト指向プログラミング言語"@ja ;
    ex:firstAppeared 1972 ;
    ex:designer person:alan-kay , person:dan-ingalls , person:adele-goldberg ;
    ex:developer org:xerox-parc ;
    ex:paradigm ex:ClassBased ;
    ex:typing ex:DynamicTyping ;
    ex:typeStrength ex:StrongTyping ;
    ex:fileExtension ".st" ;
    ex:influencedBy ex:Lisp , ex:Simula , ex:Logo .

# Prolog (1972) -- Alain Colmerauer
ex:Prolog
    a ex:ProgrammingLanguage ;
    rdfs:label "Prolog"@en ;
    schema:description "Logic programming language based on Horn clauses and backtracking search."@en ,
                       "langage de programmation logique"@fr , "logische Programmiersprache"@de ,
                       "lenguaje de programación lógica"@es ;
    rdfs:comment "The name comes from the French 'programmation en logique'."@en ;
    ex:firstAppeared 1972 ;
    ex:designer person:alain-colmerauer ;
    ex:paradigm ex:Logic ;
    ex:fileExtension ".pl" , ".pro" .

# ML (1973) -- Robin Milner
ex:ML
    a ex:ProgrammingLanguage ;
    rdfs:label "ML"@en ;
    skos:altLabel "Meta Language" ;
    schema:description "Meta Language of the LCF theorem prover, with Hindley-Milner type inference."@en ;
    ex:firstAppeared 1973 ;
    ex:designer person:robin-milner ;
    ex:developer org:university-of-edinburgh ;
    ex:paradigm ex:Functional ;
    ex:typing ex:StaticTyping ;
    ex:typeStrength ex:StrongTyping ;
    ex:typeInference true ;
    ex:influencedBy ex:ISWIM .

# SQL (1973) -- Donald D. Chamberlin, Raymond F. Boyce
ex:SQL
    a ex:QueryLanguage ;
    rdfs:label "SQL"@en ;
    skos:altLabel "SEQUEL" , "Structured Query Language" ;
    schema:description "Declarative language for querying and managing relational databases."@en ,
