# survey.trig -- FICTIONAL DATA for the sparqlite tutorial.
# Generated by tutorial/make_tutorial_data.py; edit the script, not this file.
#
# Every number and review in this file is MADE UP to demonstrate named graphs,
# GRAPH / FROM / FROM NAMED and aggregates. Nothing here is a real survey result.
#
# Layout:
#   default graph: one description of each named graph (with ex:fictional true;
#       the surveys also have ex:respondents, dcterms:issued (xsd:date) and
#       ex:marginOfError, an xsd:double such as 4.46E-3)
#   <http://example.org/graph/survey-2025> and
#   <http://example.org/graph/survey-2026>: per language
#       ex:usageShare      share of respondents using it (xsd:decimal, 0..1)
#       ex:lovedPercent    % of its users who want to keep using it (xsd:decimal)
#       ex:medianSalaryUSD median salary (xsd:integer; missing when too few answered)
#   <http://example.org/graph/editorial>:
#       reviews as blank nodes (ex:rating xsd:integer, dcterms:created xsd:dateTime
#       with a UTC offset), and ex:editorsPick true or false (xsd:boolean) for each
#       reviewed language; languages without a review have no ex:editorsPick

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/pl/> .

# --- Default graph: metadata about the named graphs ---

<http://example.org/graph/survey-2025>
    a ex:Survey ;
    rdfs:label "Developer survey 2025 (fictional)"@en ;
    rdfs:comment "FICTIONAL: invented for the sparqlite tutorial; not real survey results."@en ;
    ex:fictional true ;
    ex:surveyYear 2025 ;
    ex:respondents 48213 ;
    dcterms:issued "2025-07-15"^^xsd:date ;
    ex:marginOfError 4.46E-3 .

<http://example.org/graph/survey-2026>
    a ex:Survey ;
    rdfs:label "Developer survey 2026 (fictional)"@en ;
    rdfs:comment "FICTIONAL: invented for the sparqlite tutorial; not real survey results."@en ;
    ex:fictional true ;
    ex:surveyYear 2026 ;
    ex:respondents 51877 ;
    dcterms:issued "2026-07-14"^^xsd:date ;
    ex:marginOfError 4.30E-3 .

<http://example.org/graph/editorial>
    a ex:EditorialGraph ;
    rdfs:label "Editorial reviews (fictional)"@en ;
    rdfs:comment "FICTIONAL: invented reviews by invented editors, for the sparqlite tutorial."@en ;
    ex:fictional true .

