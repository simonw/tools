# --- FICTIONAL editorial reviews (blank nodes) ---
GRAPH <http://example.org/graph/editorial> {
    [
        a ex:Review ;
        ex:about ex:Python ;
        ex:rating 5 ;
        ex:reviewer "Mei Tanaka" ;
        dcterms:created "2026-01-12T09:14:00+09:00"^^xsd:dateTime ;
        schema:reviewBody "A gentle first language with a huge standard library."@en ,
                          "Un premier langage accessible, avec une immense bibliothèque standard."@fr
    ] .

    [
        a ex:Review ;
        ex:about ex:Python ;
        ex:rating 4 ;
        ex:reviewer "Jonas Berg" ;
        dcterms:created "2026-03-02T16:40:00+01:00"^^xsd:dateTime ;
        schema:reviewBody "Still our default choice, although packaging remains confusing."@en
    ] .

    [
        a ex:Review ;
        ex:about ex:Rust ;
        ex:rating 5 ;
        ex:reviewer "Priya Natarajan" ;
        dcterms:created "2026-02-18T11:05:00+05:30"^^xsd:dateTime ;
        schema:reviewBody "A steep learning curve, but the compiler is a patient teacher."@en
    ] .

    [
        a ex:Review ;
        ex:about ex:Rust ;
        ex:rating 4 ;
        ex:reviewer "Tomás Rivera" ;
        dcterms:created "2026-05-27T19:22:00-06:00"^^xsd:dateTime ;
        schema:reviewBody "Excellent tooling; compile times can test your patience."@en
    ] .

    [
        a ex:Review ;
        ex:about ex:Go ;
        ex:rating 4 ;
        ex:reviewer "Jonas Berg" ;
        dcterms:created "2026-01-30T07:55:00Z"^^xsd:dateTime ;
        schema:reviewBody "Small language, fast builds, boring in the best way."@en
    ] .

    [
        a ex:Review ;
        ex:about ex:JavaScript ;
        ex:rating 3 ;
        ex:reviewer "Tomás Rivera" ;
        dcterms:created "2026-02-05T22:47:00-06:00"^^xsd:dateTime ;
        schema:reviewBody "Runs everywhere; mind the implicit type conversions."@en
    ] .

    [
        a ex:Review ;
        ex:about ex:Haskell ;
        ex:rating 4 ;
